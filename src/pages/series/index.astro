---
import Base from '../../layouts/Base.astro';
import {allArticles,articleUrl} from '../../lib/content';

const articles=await allArticles();
const names=[...new Set(articles.flatMap(a=>a.data.series?[a.data.series]:[]))];
const series=names.map(name=>({
  name,
  id:name.toLowerCase().replace(/[^a-z0-9]+/g,'-'),
  chapters:articles.filter(a=>a.data.series===name).sort((a,b)=>(a.data.part||0)-(b.data.part||0))
}));
---
<Base title="Series — EllixTech">
  <section class="wrap page-intro">
    <div class="eyebrow">THE BIGGER PICTURE</div>
    <h1>Go a little<br/>deeper<span class="coral-period">.</span></h1>
    <p>Explore connected tutorials on building APIs, JavaScript, and the web.</p>
  </section>
  {series.map(group=><section class="wrap series-detail" aria-labelledby={group.id}>
    <div class="series-cover">
      <span class="eyebrow">A {group.chapters.length}-PART FIELD GUIDE</span>
      <h2 id={group.id}>{group.name}</h2>
      <span class="giant-star" aria-hidden="true">✳</span>
      <p>{group.chapters.length} chapters · {group.chapters.reduce((total,a)=>total+a.data.minutes,0)} min read</p>
    </div>
    <div class="chapter-list">
      {group.chapters.map(a=><a href={articleUrl(a.id)}>
        <span class="chapter-index">{String(a.data.part).padStart(2,'0')}</span>
        <div><span class="eyebrow">{a.data.minutes} MIN READ</span><h3>{a.data.title}</h3><p>{a.data.description}</p></div>
        <span>↗</span>
      </a>)}
    </div>
  </section>)}
</Base>
