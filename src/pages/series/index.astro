---
import Base from '../../layouts/Base.astro';import {allArticles,articleUrl} from '../../lib/content';const chapters=(await allArticles()).filter(a=>a.data.series).sort((a,b)=>(a.data.part||0)-(b.data.part||0));
---
<Base title="Series — EllixTech"><section class="wrap page-intro"><div class="eyebrow">THE BIGGER PICTURE</div><h1>Go a little<br/>deeper<span class="coral-period">.</span></h1><p>Follow a connected path from your first file to a site you can ship.</p></section><section class="wrap series-detail"><div class="series-cover"><span class="eyebrow">A THREE-PART FIELD GUIDE</span><h2>Build your<br/>corner of<br/>the web.</h2><span class="giant-star">✳</span><p>Astro fundamentals · {chapters.length} chapters</p></div><div class="chapter-list">{chapters.map(a=><a href={articleUrl(a.id)}><span class="chapter-index">0{a.data.part}</span><div><span class="eyebrow">{a.data.minutes} MIN READ</span><h3>{a.data.title}</h3><p>{a.data.description}</p></div><span>↗</span></a>)}</div></section></Base>
