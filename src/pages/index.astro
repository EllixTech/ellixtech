---
import Base from '../layouts/Base.astro';import Art from '../components/Art.astro';import Card from '../components/Card.astro';import {allArticles,articleUrl} from '../lib/content';const articles=await allArticles();const featured=articles[0];
---
<Base><section class="hero wrap"><div class="eyebrow"><span class="status-dot"></span> A JOURNAL FOR THE CURIOUS BUILDER</div><div class="hero-row"><h1>Ideas into<br/><span>engineering.</span><span class="coral-star">✳</span></h1><div class="hero-aside"><p>Exploring the how.<br/>Understanding the why.<br/>Building what comes next.</p><a class="text-link" href="/journal/">Explore the journal <span>↗</span></a></div></div><div class="hero-bottom"><span>SOFTWARE · SYSTEMS · THE WEB</span><span>INDEPENDENT THINKING, PRACTICAL KNOWLEDGE ↓</span></div></section><section class="wrap featured"><div class="featured-copy"><div class="eyebrow"><span class="small-star">✳</span> THE FEATURED READ</div><div class="feature-category">{featured.data.category}<span> / </span>{featured.data.minutes} MIN READ</div><h2><a href={articleUrl(featured.id)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><a class="button" href={articleUrl(featured.id)}>Read the story <span>↗</span></a><div class="author"><span class="avatar">E</span><span>EllixTech Editorial<small>October 28, 2026</small></span></div></div><a class="featured-art" href={articleUrl(featured.id)} aria-label={`Read ${featured.data.title}`}><Art large/><div class="art-caption"><span>LESS JAVASCRIPT.<br/>MORE POSSIBILITY.</span><span class="caption-star">✳</span></div></a></section><section class="wrap latest"><div class="section-heading"><div><div class="eyebrow">THE JOURNAL</div><h2>Fresh perspectives<span class="coral-period">.</span></h2></div><a class="text-link" href="/journal/">All articles ↗</a></div><div class="article-grid">{articles.slice(1,4).map(article=><Card article={article}/>)}</div></section><section class="wrap series-promo"><div class="series-number">01<span>— 03</span></div><div><div class="eyebrow">GO DEEPER, ONE CHAPTER AT A TIME</div><h2>Your next learning rabbit hole.</h2><p>Connected tutorials. Real projects. Knowledge that sticks.</p></div><a class="button button-light" href="/series/">Explore series ↗</a></section><section class="wrap closing"><span class="small-star">✳</span><h2>Stay curious.<br/>Keep building.</h2><p>New ideas deserve a place in your feed.<br/>Get every article, on your own terms.</p><a class="text-link" href="/rss.xml">Subscribe via RSS ↗</a></section></Base>
