---
import Base from '../../layouts/Base.astro';import Card from '../../components/Card.astro';import {allArticles} from '../../lib/content';const articles=await allArticles();const categories=[...new Set(articles.map(a=>a.data.category))];const tags=[...new Set(articles.flatMap(a=>a.data.tags))];
---
<Base title="Journal — EllixTech"><section class="wrap page-intro"><div class="eyebrow">IDEAS, EXPLORATIONS & FIELD NOTES</div><h1>The journal<span class="coral-period">.</span></h1><p>A closer look at the tools, systems, and ideas behind better software.</p></section><section class="wrap journal-list"><label class="search-box" id="search"><span>⌕</span><input id="article-search" type="search" placeholder="Search articles, topics, and technologies…" aria-label="Search articles"/><kbd>/</kbd></label><div class="filters" aria-label="Filter by category"><button class="active" data-filter="all" aria-pressed="true">All articles</button>{categories.map(c=><button data-filter={c} aria-pressed="false">{c}</button>)}</div><label class="tag-filter">Explore a tag <select id="tag-filter"><option value="">All tags</option>{tags.map(t=><option value={t}>{t}</option>)}</select></label><p id="result-count" class="result-count" role="status">{articles.length} articles to explore</p><div class="article-grid">{articles.map(article=><Card article={article}/>)}</div><p id="empty-results" hidden>No articles found. Try a different search or category.</p></section><script>
let category='all';const input=document.querySelector<HTMLInputElement>('#article-search')!;const select=document.querySelector<HTMLSelectElement>('#tag-filter')!;const cards=[...document.querySelectorAll<HTMLElement>('.article-card')];const initialTag=new URLSearchParams(location.search).get('tag');if(initialTag)select.value=initialTag;function filter(){let count=0;for(const card of cards){const matches=(category==='all'||card.dataset.category===category)&&card.dataset.search!.includes(input.value.toLowerCase().trim())&&(!select.value||card.dataset.tags!.split('|').includes(select.value.toLowerCase()));card.hidden=!matches;if(matches)count++}document.querySelector('#result-count')!.textContent=count+' article'+(count===1?'':'s')+' to explore';document.querySelector<HTMLElement>('#empty-results')!.hidden=count>0}input.addEventListener('input',filter);select.addEventListener('change',filter);document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{category=button.dataset.filter!;document.querySelectorAll('[data-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});filter()}));document.addEventListener('keydown',e=>{if(e.key==='/'&&!(e.target instanceof HTMLInputElement)&&!(e.target instanceof HTMLTextAreaElement)&&!(e.target instanceof HTMLSelectElement)){e.preventDefault();input.focus()}});filter();if(location.hash==='#search')input.focus();
</script></Base>
